{
  "provider": "openrouter",
  "use_openai_client": true,
  "writing_model": "nvidia/nemotron-3-ultra-550b-a55b:free",
  "review_model": "nvidia/nemotron-3-ultra-550b-a55b:free",
  "base_url": "https://openrouter.ai/api/v1",
  "api_key_env": "OPENROUTER_API_KEY",
  "usage_state_path": "book_output/ai_usage_state.json",
  "timeout": 900,
  "min_book_pages": 300,
  "min_chapter_words": 1000,
  "max_chapter_expansion_attempts": 4,
  "headers": {
    "HTTP-Referer": "https://github.com/local/ai-book-creator",
    "X-Title": "AI Book Creator"
  }
}
