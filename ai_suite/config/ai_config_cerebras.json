{
  "provider": "openrouter",
  "use_openai_client": true,
  "token_param": "max_tokens",
  "usage_state_path": "book_output/ai_usage_state.json",
  "timeout": 900,
  "writing_model": "gpt-oss-120b",
  "review_model": "qwen-3.8-27b",
  "base_url": "https://api.cerebras.ai/v1",
  "api_key_env": "CEREBRAS_API_KEY",
  "models": {
    "gpt-oss-120b": {
      "name": "GPT-OSS 120B (Cerebras)",
      "max_output": 65536
    },
    "qwen-3.8-27b": {
      "name": "Qwen 3.8 27B (Cerebras)",
      "max_output": 32768
    }
  }
}
