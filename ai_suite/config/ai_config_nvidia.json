      "max_output": 131072
    },
    "z-ai/glm-5.3-flash": {
      "name": "GLM-5.3 Flash (NVIDIA NIM)",
      "max_output": 131072
    },
    "deepseek-ai/deepseek-v4.1-flash": {
      "name": "DeepSeek V4.1 Flash (NVIDIA NIM)",
      "max_output": 16384
    },
    "nvidia/nemotron-3-ultra-550b-a55b": {
      "name": "Nemotron 3 Ultra (NVIDIA NIM)",
      "max_output": 65536
    }
  }
